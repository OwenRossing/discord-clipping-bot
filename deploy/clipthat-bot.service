[Unit]
Description=ClipThat Discord bot
After=network-online.target clipthat-api.service
Wants=network-online.target

[Service]
Type=simple
User=clipthat
Group=clipthat
WorkingDirectory=/opt/clipthat
ExecStart=/usr/bin/node bot/bot.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/clipthat/data /opt/clipthat/backups

[Install]
WantedBy=multi-user.target
