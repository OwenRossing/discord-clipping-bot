# Copy this to /opt/clipthat/.env on the VM and fill in real values there.
# Never commit a filled-in .env to git.

NODE_ENV=production
SESSION_SECRET=replace-with-at-least-32-random-bytes
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://clips.yourdomain.com/api/auth/discord/callback
API_HOST=127.0.0.1
API_PORT=3000
API_BASE_URL=https://clips.yourdomain.com
WEB_BASE_URL=https://clips.yourdomain.com
TRUST_PROXY=loopback
PLATFORM_OWNER_IDS=
DATABASE_PATH=./data/bot.db
CLIPS_DIR=./data/clips
DEFAULT_STORAGE_QUOTA_BYTES=1073741824
BACKUP_DIR=./backups
BACKUP_RETENTION=14
DEV_AUTH_ENABLED=false
